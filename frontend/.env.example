# Base path for API requests. In development requests are proxied by Vite.
VITE_API_BASE_URL=/api/v1

# Backend target used by the Vite dev proxy.
VITE_PROXY_TARGET=http://localhost:8080

# Optional basemap overrides (defaults to OpenStreetMap raster tiles).
# VITE_BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_BASEMAP_ATTRIBUTION=&copy; OpenStreetMap contributors
