# --- Backend ---
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# Development only. Never commit real credentials.
# Keep the port in sync with DB_PORT below.
DATABASE_URL=postgres://ismw:ismw_dev_password@localhost:5432/ismw_db?sslmode=disable
DB_MAX_CONNS=10
AUTO_MIGRATE=false

# Comma separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Development only: acting user when authentication is not implemented yet.
# Ignored (and requests rejected) when APP_ENV=production.
DEV_USER_EMAIL=admin@example.local

# --- Docker Compose (postgres container) ---
POSTGRES_DB=ismw_db
POSTGRES_USER=ismw
POSTGRES_PASSWORD=ismw_dev_password
# Host port published by docker compose. Change both values above/below together.
DB_PORT=5432
