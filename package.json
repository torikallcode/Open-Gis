{
  "name": "ismw",
  "version": "0.1.0",
  "private": true,
  "description": "ISMW - Integrated Survey & Mapping Web GIS",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && go run ./cmd/api",
    "dev:web": "cd frontend && npm run dev",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "cd backend && go run ./cmd/migrate up",
    "db:rollback": "cd backend && go run ./cmd/migrate down",
    "db:seed": "node scripts/seed.mjs",
    "install:web": "cd frontend && npm install",
    "build:web": "cd frontend && npm run build",
    "lint:web": "cd frontend && npm run lint",
    "test:api": "cd backend && go test ./..."
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
